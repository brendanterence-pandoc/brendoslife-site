/**
 * Wrangler configuration for brendoslife-site
 *
 * Deploy:  npx wrangler deploy
 * Dev:     npx wrangler dev
 *
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  // ── Identity ─────────────────────────────────────────────────────────────
  "name": "brendoslife-site",
  "main": "src/index.ts",

  // ── Compatibility ─────────────────────────────────────────────────────────
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // ── Static Assets (Workers Assets) ───────────────────────────────────────
  // All files under public/ are uploaded and served as static assets.
  // The ASSETS binding lets the Worker script fall through to them.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/marcela", "/marcela/*", "/watersedge", "/watersedge/*", "/watersedge-login", "/api/*", "/meds/api/*"]
  },

  // ── R2 Object Storage (Photo Library) ────────────────────────────────────
  "r2_buckets": [
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "brendoslife-photos"
    }
  ],

  // ── Durable Objects (MedTrack data store, SQLite-backed) ────────────────
  // Serves /meds/api/*. The app shell is static under public/meds/.
  "durable_objects": {
    "bindings": [
      { "name": "MEDTRACK", "class_name": "MedTrackDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MedTrackDO"] }
  ],

  // ── Observability ─────────────────────────────────────────────────────────
  "observability": {
    "enabled": true
  }

  // ── Future bindings (uncomment as needed) ─────────────────────────────────
  // "kv_namespaces": [
  //   { "binding": "KV", "id": "<KV_NAMESPACE_ID>" }
  // ],
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "brendoslife", "database_id": "<D1_DATABASE_ID>" }
  // ]
}
